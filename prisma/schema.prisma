generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id         String       @id @default(cuid())
  name       String
  belt       Belt         @default(WHITE)
  dob        String?
  phone      String?
  photoUrl   String?
  joinedOn   DateTime     @default(now())
  active     Boolean      @default(true)
  monthlyFee Float        @default(0)
  attendance Attendance[]
  fees       Fee[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([active])
}

enum Belt {
  WHITE
  YELLOW
  ORANGE
  GREEN
  BLUE
  MAROON
  BROWN_IV
  BROWN_III
  BROWN_II
  BROWN
  BLACK
}

model Attendance {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  date      String
  present   Boolean  @default(true)

  @@unique([studentId, date])
  @@index([date])
}

model Fee {
  id            String         @id @default(cuid())
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  month         String
  status        FeeStatus      @default(UNPAID)
  amountDue     Float          @default(0)
  amountPaid    Float          @default(0)
  paymentMethod PaymentMethod?
  paidOn        DateTime?
  remarks       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([studentId, month])
  @@index([month])
  @@index([status])
}

enum FeeStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMethod {
  CASH
  UPI
  ONLINE
}

model Admin {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  loginLogs    LoginAudit[]
  createdAt    DateTime     @default(now())
}

model LoginAudit {
  id        String   @id @default(cuid())
  admin     Admin    @relation(fields: [adminId], references: [id])
  adminId   String
  username  String
  loginTime DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([loginTime])
  @@index([username])
}

model ActivityLog {
  id        String   @id @default(cuid())
  username  String
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([username])
}
